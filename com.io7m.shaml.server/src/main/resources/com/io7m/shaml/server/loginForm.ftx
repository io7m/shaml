<!DOCTYPE html>

<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="stylesheet" type="text/css" href="/css"/>
    <title>Login</title>
  </head>
  <body>
    <h1>Login</h1>
    <p>Valid users:</p>
    <p>
      <ul>
        <li>grouch (starts with loans)</li>
        <li>ernie (starts without loans)</li>
      </ul>
    </p>
    <p>
      <form action="/saml_authenticate_run">
        <input type="text" placeholder="Username" name="user_name" required="true"/>
        <input type="submit" value="Submit" class="submit"/>
      </form>
    </p>
  </body>
</html>
